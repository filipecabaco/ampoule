diff --git a/erts/emulator/sys/common/erl_mseg.c b/erts/emulator/sys/common/erl_mseg.c
index 3381d33..6586e0c 100644
--- a/erts/emulator/sys/common/erl_mseg.c
+++ b/erts/emulator/sys/common/erl_mseg.c
@@ -683,6 +683,21 @@ void erts_mseg_clear_cache(void) {
     mseg_clear_cache(ERTS_MSEG_ALLCTR_IX(0));
 }
 
+#if defined(__wasi__)
+/* ampoule: linear memory has a hard limit (--memory-max, or 4 GiB). When it is reached, segments
+ * waiting in this allocator's cache are released and the allocation tried again, rather than
+ * failing while they sit unused. Called with `ma` locked, as mseg_alloc is. */
+static void mseg_drop_all_cached(ErtsMsegAllctr_t *ma) {
+    int i;
+    for (i = 0; i < CACHE_AREAS; i++) {
+	if (!erts_circleq_is_empty(&(ma->cache_powered_node[i])))
+	    mseg_drop_cache_size(ma, ERTS_MSEG_FLG_2POW, &(ma->cache_powered_node[i]));
+    }
+    if (!erts_circleq_is_empty(&(ma->cache_unpowered_node)))
+	mseg_drop_cache_size(ma, ERTS_MSEG_FLG_NONE, &(ma->cache_unpowered_node));
+}
+#endif
+
 static void *
 mseg_alloc(ErtsMsegAllctr_t *ma, ErtsAlcType_t atype, UWord *size_p,
 	   Uint flags, const ErtsMsegOpt_t *opt)
@@ -706,6 +721,12 @@ mseg_alloc(ErtsMsegAllctr_t *ma, ErtsAlcType_t atype, UWord *size_p,
 	goto done;
 
     seg = mseg_create(ma, flags, &size);
+#if defined(__wasi__)
+    if (!seg && ma->cache_size > 0) {
+	mseg_drop_all_cached(ma);
+	seg = mseg_create(ma, flags, &size);
+    }
+#endif
 
     if (!seg)
 	*size_p = 0;
