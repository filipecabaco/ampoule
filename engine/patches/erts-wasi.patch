diff --git a/erts/emulator/sys/unix/sys_drivers.c b/erts/emulator/sys/unix/sys_drivers.c
index c06d6b6..c53279c 100644
--- a/erts/emulator/sys/unix/sys_drivers.c
+++ b/erts/emulator/sys/unix/sys_drivers.c
@@ -77,6 +77,13 @@ static Eterm forker_port;
 #include "erl_sys_driver.h"
 #include "sys_uds.h"
 
+#if defined(__wasi__)
+/* The runtime is erl_child_setup: a Start request and its fds go to it through an import, which
+ * takes its own references to the fds, as passing them over a unix socket would. */
+#undef sys_uds_write
+#define sys_uds_write(fd, buf, len, fds, nfds, flags) aos_forker_write((fd), (buf), (len), (fds), (nfds))
+#endif
+
 #include "erl_child_setup.h"
 
 #if defined IOV_MAX
@@ -1598,6 +1605,16 @@ static ErlDrvData forker_start(ErlDrvPort port_num, char* name,
 
     forker_port = erts_drvport2id(port_num);
 
+#if defined(__wasi__)
+    /* There is no erl_child_setup to fork: the runtime plays it. forker_fd is the pipe it
+       reports exits on, and Start requests reach it through sys_uds_write (see above). */
+    forker_fd = aos_forker();
+    if (forker_fd < 0)
+        erts_exit(ERTS_ABORT_EXIT, "Could not start the runtime's child setup: %d\n", errno);
+    SET_NONBLOCKING(forker_fd);
+    return (ErlDrvData)port_num;
+#endif
